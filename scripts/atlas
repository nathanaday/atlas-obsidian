#!/bin/sh
# Runs the installed atlas-obsidian binary for the plugin's MCP server and hooks.
# The plugin cache holds skills and manifests only; the binary is installed separately
# (Homebrew or `go install`) so it matches the machine.
set -u
for candidate in \
  "${ATLAS_OBSIDIAN_BIN:-}" \
  "$(command -v atlas-obsidian 2>/dev/null)" \
  "$HOME/go/bin/atlas-obsidian" \
  "/opt/homebrew/bin/atlas-obsidian" \
  "/usr/local/bin/atlas-obsidian" \
  "${PLUGIN_DATA:-${CLAUDE_PLUGIN_DATA:-/nonexistent}}/bin/atlas-obsidian"
do
  if [ -n "$candidate" ] && [ -x "$candidate" ]; then
    exec "$candidate" "$@"
  fi
done
echo "atlas-obsidian: the atlas-obsidian binary is not installed." >&2
echo "Install it with: go install github.com/nathanaday/atlas-obsidian/cmd/atlas-obsidian@latest" >&2
echo "or set ATLAS_OBSIDIAN_BIN to its path." >&2
exit 1
